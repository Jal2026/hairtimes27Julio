{
  "jobs": [
    {
      "functionLocation": "/reminderJob.js",
      "functionName": "reminderJobDaily",
      "description": "[ReminderJob v1.0.0] Recordatorio diario de citas 24h antes (07:00 UTC = 08-09h Madrid)",
      "executionConfig": {
        "cronExpression": "0 7 * * *"
      }
    },
    {
      "functionLocation": "/googleCalendarSyncJob.js",
      "functionName": "googleCalendarSyncDaily",
      "description": "[GCalSync v1.1.0] Sync diario agenda KAMISUITE -> Google Calendar (05:00 UTC = 07:00h Madrid verano)",
      "executionConfig": {
        "cronExpression": "0 5 * * *"
      }
    },
    {
      "functionLocation": "/resumenDiarioJob.js",
      "functionName": "resumenDiarioTick00",
      "description": "[ResumenDiario v1.1.3] Tick :00. Una de las 4 tareas escalonadas. Cada una se repite 1 vez/hora (limite Wix); juntas dan precision de cuarto de hora. Envia solo si coincide con SalonConfig.dailySummaryTime",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/resumenDiarioJob.js",
      "functionName": "resumenDiarioTick15",
      "description": "[ResumenDiario v1.1.3] Tick :15",
      "executionConfig": {
        "cronExpression": "15 * * * *"
      }
    },
    {
      "functionLocation": "/resumenDiarioJob.js",
      "functionName": "resumenDiarioTick30",
      "description": "[ResumenDiario v1.1.3] Tick :30",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
    {
      "functionLocation": "/resumenDiarioJob.js",
      "functionName": "resumenDiarioTick45",
      "description": "[ResumenDiario v1.1.3] Tick :45",
      "executionConfig": {
        "cronExpression": "45 * * * *"
      }
    }
  ]
}
